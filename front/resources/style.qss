QWidget {
    background-color: #1E1E2E;
    color: #CDD6F4;
    font-family: "Segoe UI", sans-serif;
    font-size: 14px;
}

/* Tab widget */
QTabWidget::pane {
    border: 1px solid #45475A;
    border-radius: 4px;
    background: #1E1E2E;
}
QTabBar::tab {
    background: #313244;
    color: #A6ADC8;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: #89B4FA;
    color: #11111B;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    background: #45475A;
}

/* Buttons */
QPushButton {
    background-color: #89B4FA;
    color: #11111B;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton:hover {
    background-color: #B4BEFE;
}
QPushButton:pressed {
    background-color: #74C7EC;
}
QPushButton:disabled {
    background-color: #45475A;
    color: #A6ADC8;
}

/* ComboBox */
QComboBox {
    background-color: #313244;
    border: 1px solid #45475A;
    border-radius: 4px;
    padding: 6px 12px;
    color: #CDD6F4;
}
QComboBox::drop-down {
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #313244;
    border: 1px solid #45475A;
    selection-background-color: #89B4FA;
    selection-color: #11111B;
}

/* Text Edit */
QTextEdit {
    background-color: #11111B;
    border: 1px solid #45475A;
    border-radius: 6px;
    padding: 10px;
    color: #A6E3A1;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
}
QScrollBar:vertical {
    background: #1E1E2E;
    width: 10px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #45475A;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Labels */
QLabel {
    color: #CDD6F4;
    font-size: 15px;
}
